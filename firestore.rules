rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function ownsBusiness(uid) {
      return request.auth != null && request.auth.uid == uid
        && exists(/databases/$(database)/documents/authorizedUsers/$(uid));
    }

    match /users/{uid}/{collection}/{record} {
      allow read, create, update: if ownsBusiness(uid) &&
        (collection in ['products', 'purchases', 'sales', 'expenses'] ||
          (collection == 'settings' && record == 'general'));
    }
  }
}
